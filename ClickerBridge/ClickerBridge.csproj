<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Мод-прослойка между кликером и Unity-игрой (BepInEx 6, IL2CPP).
    Сборка:  dotnet build -c Release -p:GameDir="путь\к\папке\игры"
    Игру с BepInEx нужно один раз запустить заранее, чтобы появилась папка BepInEx\interop.
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>ClickerBridge</AssemblyName>
    <RootNamespace>ClickerBridge</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GameDir Condition="'$(GameDir)' == ''">C:\NotYours\My Games\1.2.8.2505.06</GameDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="InteropFix\**" />
    <None Remove="InteropFix\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(BepInExDir)\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\MonoMod.RuntimeDetour.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.InputLegacyModule.dll" Private="false" />
  </ItemGroup>

  <!-- После сборки сразу кладём мод в BepInEx\plugins игры -->
  <Target Name="CopyToGame" AfterTargets="Build" Condition="Exists('$(BepInExDir)\plugins')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins" />
  </Target>

</Project>
